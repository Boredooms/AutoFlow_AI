# AutoFlow AI — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# Secrets are resolved only at the provider/connector boundary and must never
# reach the desktop renderer, model prompts, or logs.

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Datastores ----
DATABASE_URL=postgresql://autoflow:autoflow@localhost:5432/autoflow
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=
CHROMA_PATH=./.chroma

# ---- Primary model (planner/executor) ----
# The gateway speaks the OpenAI-compatible Chat Completions API, so any of the
# following work by setting PROVIDER=openai_compatible and the right BASE_URL:
#
#   NVIDIA NIM:   BASE_URL=https://integrate.api.nvidia.com/v1
#                 ID=meta/llama-3.2-11b-vision-instruct   (list: GET /v1/models)
#   OpenAI:       BASE_URL=https://api.openai.com/v1
#                 ID=gpt-4o-mini
#   Groq:         BASE_URL=https://api.groq.com/openai/v1
#                 ID=llama-3.3-70b-versatile
#   OpenRouter:   BASE_URL=https://openrouter.ai/api/v1
#                 ID=meta-llama/llama-3.1-8b-instruct
#   vLLM (local): BASE_URL=http://localhost:8000/v1
#   Ollama:       BASE_URL=http://localhost:11434/v1
#
PRIMARY_MODEL_PROVIDER=openai_compatible
PRIMARY_MODEL_ID=meta/llama-3.2-11b-vision-instruct
PRIMARY_MODEL_API_KEY=
PRIMARY_MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_MODEL_CONTEXT=128000

# ---- Secondary / fallback model (optional) ----
# Set *_MODEL_STREAMING=true for providers that only return content via SSE
# streaming (e.g. ModelScope reasoning models like Qwen/Qwen3-8B).
#   ModelScope: BASE_URL=https://api-inference.modelscope.ai/v1
#               ID=Qwen/Qwen3-8B  STREAMING=true
SECONDARY_MODEL_PROVIDER=
SECONDARY_MODEL_ID=
SECONDARY_MODEL_API_KEY=
SECONDARY_MODEL_BASE_URL=
SECONDARY_MODEL_CONTEXT=128000
SECONDARY_MODEL_STREAMING=false

# ---- Vision model ----
VISION_MODEL_PROVIDER=
VISION_MODEL_ID=
VISION_MODEL_API_KEY=

# ---- RAG (knowledge / semantic retrieval) ----
RAG_ENABLED=true
RAG_TOP_K=8
RAG_MAX_TOP_K=20
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_SCORE=0.0
RAG_RERANK_ENABLED=false
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=autoflow_knowledge
MAX_DOCUMENT_SIZE_MB=25
MAX_CHUNKS_PER_DOCUMENT=5000

# ---- Memory (session / workflow / graph) ----
MEMORY_ENABLED=true
WORKFLOW_MEMORY_ENABLED=true
WORKFLOW_MEMORY_COLLECTION=autoflow_workflows
MEMORY_DB_PATH=./data/memory.sqlite
WORKFLOW_RETRIEVAL_TOP_K=5
WORKFLOW_MEMORY_MIN_SCORE=0.0
WORKFLOW_AUTO_PROMOTION=false
WORKFLOW_MAX_VERSIONS=50
MEMORY_FAILURE_DECAY=true
MEMORY_RECENCY_WEIGHT=0.15
MEMORY_SUCCESS_WEIGHT=0.35
MEMORY_COMPATIBILITY_WEIGHT=0.30
MEMORY_SEMANTIC_WEIGHT=0.20

# ---- Embeddings ----
# EMBEDDING_PROVIDER: "local" (deterministic hashing, offline, non-semantic
# baseline) or "openai_compatible" (real semantic embeddings via an
# OpenAI-compatible /embeddings endpoint: NVIDIA NIM, ModelScope, OpenAI, etc.)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# ---- Model call policy ----
MODEL_TIMEOUT=60
MODEL_MAX_RETRIES=2

# ---- Execution budgets (bounded autonomy) ----
MAX_TOOL_CALLS=50
MAX_REPLANS=3
MAX_RECOVERY_ATTEMPTS=5

# ---- Execution surfaces (disabled by default) ----
BROWSER_EXECUTION_ENABLED=false
DESKTOP_EXECUTION_ENABLED=false

# ---- Communication connector ----
EMAIL_PROVIDER=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=

# ---- Local deployment / server (added in the integration pass) ----
# Local orchestration API + frontend (autoflow serve).
AUTOFLOW_HOST=127.0.0.1
AUTOFLOW_PORT=8770
# Model cache root for downloadable local models (never inside the repo).
AUTOFLOW_MODEL_HOME=
# Opt-in gates for real (non-simulated) capabilities. Leave empty/0 for safe defaults.
AUTOFLOW_ALLOW_WEB=0
AUTOFLOW_REAL_WORD=0
AUTOFLOW_REAL_GMAIL=0
AUTOFLOW_REAL_VISION=0
AUTOFLOW_LIVE_NVIDIA=0
# Mission checkpoint store (defaults to ./.autoflow/missions when unset).
AUTOFLOW_MISSION_DIR=
