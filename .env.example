# AutoFlow AI — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# Secrets are resolved only at the provider/connector boundary and must never
# reach the desktop renderer, model prompts, or logs.

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Datastores ----
DATABASE_URL=postgresql://autoflow:autoflow@localhost:5432/autoflow
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=
CHROMA_PATH=./.chroma

# ---- Primary model (planner/executor) ----
PRIMARY_MODEL_PROVIDER=
PRIMARY_MODEL_ID=
PRIMARY_MODEL_API_KEY=

# ---- Secondary / fallback model ----
SECONDARY_MODEL_PROVIDER=
SECONDARY_MODEL_ID=
SECONDARY_MODEL_API_KEY=

# ---- Vision model ----
VISION_MODEL_PROVIDER=
VISION_MODEL_ID=
VISION_MODEL_API_KEY=

# ---- Embeddings ----
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# ---- Model call policy ----
MODEL_TIMEOUT=60
MODEL_MAX_RETRIES=2

# ---- Execution budgets (bounded autonomy) ----
MAX_TOOL_CALLS=50
MAX_REPLANS=3
MAX_RECOVERY_ATTEMPTS=5

# ---- Execution surfaces (disabled by default) ----
BROWSER_EXECUTION_ENABLED=false
DESKTOP_EXECUTION_ENABLED=false

# ---- Communication connector ----
EMAIL_PROVIDER=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
